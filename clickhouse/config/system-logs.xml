<!--
  ClickHouse keeps a diary of itself in tables under "system" and in a log
  file. With the defaults this stack wrote about a gigabyte a day of them,
  twenty times what the market data took: every poll of every Kafka table is
  logged at trace level, and none of the tables ever expire.

  Kept, for seven days: query_log (what ran, how long it took) and part_log
  (what was written and merged). The rest is switched off.
-->
<clickhouse>
    <logger>
        <level>information</level>
    </logger>

    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>

    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
